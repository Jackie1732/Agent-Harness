import { createHarnessClient } from '@atomic-harness/core/client'
import type { ControlMethod, Params, Result } from '@atomic-harness/core/protocol'
import { openHarnessUiServer } from '@atomic-harness/core/ui'
import { openHarnessAutomation } from '@atomic-harness/core/automation'
import { createEventName, createMiddlewareName } from '@atomic-harness/core'
import type { EventName, MiddlewareName, RootScope } from '@atomic-harness/core'

void openHarnessUiServer
void openHarnessAutomation

async function typed(client: ReturnType<typeof createHarnessClient>) {
  const method: ControlMethod = 'input.submit'
  const params: Params<typeof method> = { agentKey: 'writer', submissionKey: 'paper-1', text: 'Summarize the experiment' }
  const receipt: Result<typeof method> = await client.request(method, params)
  const input = await client.request('input.get', { agentKey: 'writer', inputEventId: receipt.inputEventId })
  if (input.rootId !== null) {
    const root = await client.request('root.get', { agentKey: 'writer', rootId: input.rootId })
    if (root.final !== null) root.final.text?.toUpperCase()
  }
  for await (const page of client.events({ target: { kind: 'member', agentKey: 'writer' }, maxEvents: 3 })) {
    const through: number = page.through
    void through
    page.events.forEach(event => { const id: string = event.eventId; void id })
  }
  // @ts-expect-error A durable submission key is required.
  await client.request('input.submit', { agentKey: 'writer', text: 'missing key' })
  // @ts-expect-error A method cannot be replaced with an arbitrary operation.
  await client.request('host.serve', {})
  // @ts-expect-error Send parameters cannot smuggle a reply command.
  await client.request('message.send', { agentKey: 'writer', kind: 'reply', messageId: 'arbitrary', type: 'test/note', payloadVersion: 1, payloadJson: '{}' })
}
void typed

interface Payload { readonly kind: string }
interface Reading extends Payload { readonly value: number }
const reading = createEventName<Reading>('pack.reading')
const transform = createMiddlewareName<Reading, Reading>('pack.transform')
function extensions(scope: RootScope) {
  scope.on(reading, 'general listener', (payload: Payload) => { void payload.kind })
  void scope.emit(reading, { kind: 'measurement', value: 1 })
  void scope.invoke(transform, { kind: 'measurement', value: 1 }, request => request)
  // @ts-expect-error A token cannot admit payloads incompatible with its listeners.
  const widenedEvent: EventName<Payload> = reading
  // @ts-expect-error A middleware token fixes its request type.
  const widenedRequest: MiddlewareName<Payload, Reading> = transform
  // @ts-expect-error A middleware token fixes its result type.
  const widenedResult: MiddlewareName<Reading, Payload> = transform
  // @ts-expect-error The terminal cannot widen the registered result type.
  void scope.invoke(transform, { kind: 'measurement', value: 1 }, () => ({ kind: 'missing value' }))
  void widenedEvent
  void widenedRequest
  void widenedResult
}
void extensions
